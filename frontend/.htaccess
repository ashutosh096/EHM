<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # Prevent rewriting of the index file itself
  RewriteRule ^index\.html$ - [L]

  # Serve route-specific social preview metadata to crawlers that do not run React.
  RewriteCond %{HTTP_USER_AGENT} (WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot) [NC]
  RewriteRule ^offerings/sustainability-assessment-reporting/?$ /starc-preview.html [L]

  # If the request is for a real file or directory, serve it as is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Otherwise redirect everything to index.html
  RewriteRule . /index.html [L]
</IfModule>
